@model Vendor

@{
}
<form method="post" asp-action="Create">
    <div class="form-group">
        <label asp-for="Name">Vendor Name</label>
        <input asp-for="Name" class="form-control" placeholder="Enter Vendor Name">
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Type">Vendor Type</label>
        <select asp-for="Type" asp-items="@Html.GetEnumSelectList<VendorType>().OrderBy(item => item.Text)" class="form-control form-control-lg">
            <option value="">--Select--</option>
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Location">Location</label>
        <input asp-for="Location" class="form-control" placeholder="Enter Location">
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>

